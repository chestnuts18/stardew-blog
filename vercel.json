{
  "buildCommand": "hexo generate",
  "outputDirectory": "public",
  "framework": "hexo",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/douyin",
      "destination": "https://www.iesdouyin.com/share/user/MS4wLjABAAAAiG18r739_4WmBxoFrSZF4iNddozppXJiKTel28vRF5k?sec_uid=MS4wLjABAAAAiG18r739_4WmBxoFrSZF4iNddozppXJiKTel28vRF5k&from_ssr=1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/images/cursor/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "image/x-icon" }
      ]
    },
    {
      "source": "/images/emotes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/preload/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*\\.jpg|.*\\.png|.*\\.gif|.*\\.webp|.*\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
